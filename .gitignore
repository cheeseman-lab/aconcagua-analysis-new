# ignore files generated during run
analysis/.snakemake/
analysis/slurm/slurm_output/
analysis/brieflow_output/

# ignore benchmark results
benchmarks/results/

# ignore large Funk external data (HDF, extracted features, supplementary CSV)
benchmarks/external/*.hdf
benchmarks/external/*.tsv
benchmarks/external/*.csv
benchmarks/external/results/
benchmarks/external/logs/
benchmarks/__pycache__/

# ignore .env
analysis/.env

# macOS metadata
.DS_Store

# Claude Code session files
.claude/

# Slurm job logs (root-level)
*.err
*.out

# Aspera transfer files
aspera-transfer-*

# Submission package outputs (keep the script, ignore generated files)
analysis/submission_package/figures/
analysis/submission_package/excel/
analysis/submission_package/*.zip

# BIA upload logs
analysis/bia_upload/logs/